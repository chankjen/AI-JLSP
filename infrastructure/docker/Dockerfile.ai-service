# ============================================================================
# Dockerfile for FastAPI AI Microservice - AI-JLSP
# Multi-stage: base → dependencies → runtime
# COMPLIANCE: Legal-BERT-KE RAG, DPA Sec 26 (Security), Kenya-hosted inference
# ============================================================================

FROM python:3.11-slim as base

LABEL maintainer="Legal Technology & Product Engineering Division"
LABEL description="AI-JLSP FastAPI Service - Legal-BERT-KE RAG, Document Validation Pipeline"

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# ============================================================================
# Dependencies Stage
# ============================================================================

FROM base as dependencies

# Install Python build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY requirements.txt .

# Install Python packages
RUN pip install --upgrade pip setuptools wheel && \
    pip install -r requirements.txt

# ============================================================================
# Runtime Stage
# ============================================================================

FROM base as runtime

# Create non-root user (DPA Sec 26: Security principle)
RUN addgroup --system --gid 1001 python && \
    adduser --system --uid 1001 --gid 1001 python

# Copy installed packages from dependencies stage
COPY --from=dependencies /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=dependencies /usr/local/bin /usr/local/bin

# Copy application code
COPY --chown=python:python app ./app
COPY --chown=python:python models ./models
COPY --chown=python:python pipelines ./pipelines
COPY --chown=python:python config ./config

# Create cache and logs directories
RUN mkdir -p /app/cache /app/logs && chown -R python:python /app

# Switch to non-root user
USER python

# Expose port
EXPOSE 3002

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
  CMD curl -f http://localhost:3002/health || exit 1

# Set environment
ENV PYTHONPATH=/app:$PYTHONPATH

# Start FastAPI server with Uvicorn
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "3002", "--workers", "2"]
