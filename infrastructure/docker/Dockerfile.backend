# ============================================================================
# Dockerfile for Node.js/Express Backend - AI-JLSP
# Multi-stage build: dependencies → builder → runtime
# COMPLIANCE: OWASP ASVS L2, JWT + RBAC, TLS 1.3, AES-256 encryption
# ============================================================================

FROM node:18-alpine AS dependencies

WORKDIR /app

# Install build dependencies
RUN apk add --no-cache python3 make g++ curl

# Copy package files
COPY packages/backend/package*.json ./
COPY packages/shared/package*.json ./shared/

# Install dependencies with security audit
RUN npm ci --audit-level=moderate

# ============================================================================
# Builder Stage
# ============================================================================

FROM node:18-alpine AS builder

WORKDIR /app

# Copy dependencies from dependencies stage
COPY --from=dependencies /app/node_modules ./node_modules
COPY --from=dependencies /app/shared ./shared

# Copy application source
COPY packages/backend ./

# Run TypeScript compilation
RUN npm run build

# ============================================================================
# Runtime Stage
# ============================================================================

FROM node:18-alpine

LABEL maintainer="Legal Technology & Product Engineering Division"
LABEL description="AI-JLSP Backend - Express + PostgreSQL + RBAC + Audit Logging"

WORKDIR /app

# Install runtime dependencies
RUN apk add --no-cache dumb-init curl

# Create non-root user (DPA Sec 26: Security principle)
RUN addgroup -g 1001 -S nodejs
RUN adduser -S backend -u 1001

# Copy from builder stages
COPY --from=dependencies /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/package*.json ./
COPY --from=builder /app/shared ./shared

# Create logs directory
RUN mkdir -p /app/logs && chown -R backend:nodejs /app

# Switch to non-root user
USER backend

# Expose port
EXPOSE 3001

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD curl -f http://localhost:3001/health || exit 1

# Set environment
ENV NODE_ENV=production
ENV NODE_OPTIONS="--max-old-space-size=512"

# Use dumb-init to properly handle signals
ENTRYPOINT ["dumb-init", "--"]

# Start Express server
CMD ["node", "dist/app.js"]
