# Backend Configuration
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL=postgresql://jlsp_user:jlsp_pass_secure@localhost:5432/ai_jlsp_db

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRY=7d
JWT_REFRESH_EXPIRY=30d

# CORS
ALLOWED_ORIGIN=http://localhost:3000

# SMTP (Email Notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
NOTIFICATION_EMAIL=noreply@legaltech.ke

# Redis
REDIS_URL=redis://localhost:6379

# AI Service
AI_SERVICE_URL=http://localhost:8000

# ODPC Integration (Data Protection Authority)
ODPC_API_URL=https://api.odpc.go.ke
ODPC_API_KEY=your_odpc_api_key_here

# Logging
LOG_LEVEL=info

# File Upload
MAX_FILE_SIZE=52428800
UPLOAD_DIR=./uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# MFA
MFA_WINDOW=4
MFA_STEP=30

# Session
SESSION_EXPIRY_MS=86400000
