# ============================================================================
# AI-JLSP Environment Configuration Template
# ============================================================================
# COMPLIANCE ANCHORS:
# - DPA Sec 25-43 (lawful processing, consent, data minimization, security)
# - Constitution Art 31 (privacy), Art 47 (fair admin action)
# - Data Sovereignty: Kenya-hosted only (DPA Sec 50)
# ============================================================================

# ============================================================================
# ENVIRONMENT & DEPLOYMENT
# ============================================================================
NODE_ENV=development
DEPLOYMENT_ENV=local
LOG_LEVEL=info
DEBUG=false

# ============================================================================
# DATABASE (PostgreSQL 15 - DPA Sec 26: Security Safeguards)
# ============================================================================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=ai_jlsp
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_IN_PRODUCTION
DB_SSL=true

# Encryption at rest (AES-256)
ENCRYPTION_KEY=GENERATE_ME_WITH_scripts/generate-keys.sh
DB_ENCRYPTION_ALGORITHM=aes-256-cbc

# Connection pool (DPA Sec 25: data minimization)
DB_POOL_MIN=5
DB_POOL_MAX=20

# ============================================================================
# REDIS (Sessions, DPA Consent Cache, Rate Limiting)
# ============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_IN_PRODUCTION
REDIS_DB=0
REDIS_TTL_SESSIONS=86400
REDIS_TTL_AUDIT_CACHE=604800

# ============================================================================
# QDRANT (Vector Database - Legal-BERT-KE Embeddings)
# ============================================================================
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=CHANGE_ME_IN_PRODUCTION
QDRANT_COLLECTION_NAME=legal_documents
QDRANT_EMBEDDING_SIZE=384

# ============================================================================
# JWT & AUTHENTICATION (Constitution Art 47: Fair Admin)
# ============================================================================
JWT_SECRET=GENERATE_ME_WITH_scripts/generate-keys.sh
JWT_ALGORITHM=HS256
JWT_EXPIRY=86400
JWT_REFRESH_EXPIRY=604800
MFA_ENABLED=true
MFA_ISSUER=AI-JLSP

# ============================================================================
# BACKEND SERVICE (Node.js/Express)
# ============================================================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=3001
API_BASE_URL=http://localhost:3001
CORS_ORIGIN = http://localhost:3000
CORS_CREDENTIALS=true
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================================
# AI SERVICE (FastAPI - AI/ML Pipeline)
# ============================================================================
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=3002
AI_SERVICE_URL=http://ai-service:3002
LEGAL_BERT_MODEL=sentence-transformers/legal-bert-base
MODEL_CACHE_DIR=/app/models
MODEL_DEVICE=cpu

# AI Confidence Thresholds (Human-in-the-Loop)
AI_CONFIDENCE_THRESHOLD_HIGH=0.85
AI_CONFIDENCE_THRESHOLD_MEDIUM=0.65
AI_CONFIDENCE_THRESHOLD_LOW=0.40

# AI Governance (Constitution Art 47, DPA Sec 22)
AI_ENABLE_EXPLANATIONS=true
AI_ENABLE_AUDIT_TRAILS=true
AI_ENABLE_HUMAN_OVERRIDE=true
AI_BIAS_DETECTION_THRESHOLD=0.02

# ============================================================================
# FRONTEND (Next.js 14)
# ============================================================================
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:3002
NEXT_PUBLIC_LOCALE=en
NEXT_PUBLIC_AVAILABLE_LOCALES=en,sw,ksl
NEXT_PUBLIC_THEME=light
NEXT_PUBLIC_A11Y_TESTING=false

# ============================================================================
# DATA PROTECTION & DPA COMPLIANCE (DPA Sec 25-43)
# ============================================================================
DPA_PROCESSING_PURPOSE=judicial_legal_services
DPA_LAWFUL_BASIS=legal_obligation
DPA_DATA_RETENTION_DAYS=2555
DPA_BREACH_NOTIFICATION_DAYS=90
DPA_ENCRYPTION_ENABLED=true
DPA_AUDIT_RETENTION_YEARS=7

# Consent Management (DPA Sec 22)
CONSENT_TRACKING_ENABLED=true
CONSENT_EXPIRY_DAYS=365
CONSENT_AUDIT_LOGGING=true

# Impact Assessment (DPA Sec 35)
DPIA_THRESHOLD=10000
DPIA_AUTO_REVIEW=true

# Data Sovereignty (DPA Sec 50)
DATA_RESIDENCY=KE
DATA_CENTER_LOCATION=Kenya
ALLOW_CROSS_BORDER_TRANSFER=false

# ============================================================================
# AUDIT & COMPLIANCE LOGGING (DPA Sec 31, Constitution Art 47)
# ============================================================================
AUDIT_LOGGING_ENABLED=true
AUDIT_LOG_DESTINATION=database
AUDIT_LOG_RETENTION_DAYS=2555
AUDIT_RETENTION_IMMUTABLE=true
AUDIT_HASH_ALGORITHM=sha256
AUDIT_ENCRYPTION_ENABLED=true

# Access Logs
ACCESS_LOG_ENABLED=true
ACCESS_LOG_LEVEL=info
ACCESS_LOG_RETENTION_DAYS=90

# ============================================================================
# RBAC & AUTHORIZATION (Constitution Art 47)
# ============================================================================
RBAC_ENABLED=true
RBAC_CACHE_TTL=3600
RBAC_ENFORCEMENT_LEVEL=strict
AVAILABLE_ROLES=advocate,tdr_officer,board_secretary,litigation_counsel,citizen,admin,dpo
DEFAULT_ROLE=citizen

# ============================================================================
# MAIL & NOTIFICATIONS (DPA Sec 30: Data Subject Rights)
# ============================================================================
MAIL_PROVIDER=sendgrid
MAIL_FROM=noreply@ai-jlsp.judiciary.go.ke
MAIL_API_KEY=CHANGE_ME_IN_PRODUCTION
MAIL_TEMPLATES_DIR=./templates/emails
BREACH_NOTIFICATION_EMAIL=dpo@judiciary.go.ke

# ============================================================================
# THIRD-PARTY INTEGRATIONS (DPA Sec 45: Processors)
# ============================================================================
# eKLR API (Kenya Law Reports)
EKLR_API_KEY=CHANGE_ME_IN_PRODUCTION
EKLR_API_URL=https://api.eklr.go.ke

# Ardhi Sasa (Land Registry)
ARDHI_SASA_API_KEY=CHANGE_ME_IN_PRODUCTION
ARDHI_SASA_API_URL=https://api.ardhi.go.ke

# Judiciary eFiling System
EFILING_API_KEY=CHANGE_ME_IN_PRODUCTION
EFILING_API_URL=https://api.efiling.judiciary.go.ke

# KRA Integration
KRA_API_KEY=CHANGE_ME_IN_PRODUCTION
KRA_API_URL=https://api.kra.go.ke

# ============================================================================
# MONITORING & OBSERVABILITY
# ============================================================================
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_SAMPLE_RATE=0.1

DATADOG_ENABLED=false
DATADOG_API_KEY=
DATADOG_SITE=datadoghq.com

# ============================================================================
# SECURITY HEADERS & CORS (OWASP ASVS L2)
# ============================================================================
CSP_HEADER=default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'
X_FRAME_OPTIONS=DENY
X_CONTENT_TYPE_OPTIONS=nosniff
STRICT_TRANSPORT_SECURITY=max-age=31536000; includeSubDomains

# ============================================================================
# FEATURE FLAGS
# ============================================================================
FEATURE_ENABLE_PREDICTIVE_ANALYTICS=true
FEATURE_ENABLE_MULTILINGUAL_UI=true
FEATURE_ENABLE_ACCESSIBILITY_TOOLS=true
FEATURE_ENABLE_AI_PRE_VALIDATION=true
FEATURE_ENABLE_DEADLINE_ENGINE=true
FEATURE_ENABLE_DPA_CONSENT_LAYER=true
